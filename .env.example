# Copy to .env.local and fill in. `.env.local` is gitignored; never commit real values.

# Jev via Vercel AI Gateway: either the OIDC token from `vercel env pull .env.local`
# (VERCEL_OIDC_TOKEN, written by that command) or your own gateway key:
AI_GATEWAY_API_KEY=

# Required on Vercel for decisions to run (otherwise they rest, failing closed):
# Random signing secret for the device cookie, 32+ characters, e.g. `openssl rand -hex 32`
JEV_COOKIE_SECRET=
# Upstash Redis REST credentials (Vercel Marketplace injects these on deploy)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional tuning (defaults shown in lib/limits/config.ts):
# JEV_ENABLED=true
# JEV_VISITOR_DAILY_LIMIT=40
# JEV_DAILY_BUDGET_USD=2
